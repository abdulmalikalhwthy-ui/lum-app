<?xml version='1.0' encoding='utf-8'?>
<widget id="com.lum.movement" version="4.3.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>الحركة العامة</name>
    <description>تطبيق استخراج الحركة العامة لأي تسلسل صوتي وفق منهج عالم سبيط النيلي</description>
    <author email="abdulmalik@alqaim.org" href="https://alqaim.org">عبد الملك علي الحوثي — مؤسسة القائم الحجة</author>

    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- إعدادات Android -->
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="android-compileSdkVersion" value="36" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#1E2A5A" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="#1E2A5A" />
    <preference name="FullScreen" value="false" />
</widget>
